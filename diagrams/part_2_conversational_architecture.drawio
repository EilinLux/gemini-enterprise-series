<mxfile host="65bd71144e">
    <diagram id="part-2-architecture" name="Part 2 Multi-Agent Architecture">
        <mxGraphModel dx="1025" dy="1249" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1100" pageHeight="750" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="browser" value="&lt;b&gt;EMPLOYEE / CLIENT WEB BROWSER&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#5f6368&quot;&gt;(Gemini Enterprise Web App UI: &quot;Ask DoubleClick Enterprise Anything&quot;)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F0FE;strokeColor=#4285F4;strokeWidth=2;fontFamily=Helvetica;fontSize=14;fontColor=#202124;shadow=1;arcSize=12;" parent="1" vertex="1">
                    <mxGeometry x="280" y="30" width="540" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="primary_assistant" value="&lt;b style=&quot;font-size:15px;&quot;&gt;GEMINI ENTERPRISE PRIMARY ASSISTANT&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#7c3aed&quot; style=&quot;font-size:13px;&quot;&gt;&lt;b&gt;(Top-Level Orchestrator Hub: double-click-enterprise-app)&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;hr style=&quot;border: 0; border-top: 1px solid #d8b4fe; margin: 8px 0;&quot;&gt;&lt;div align=&quot;left&quot; style=&quot;font-size:12px; line-height: 1.6; padding-left: 10px;&quot;&gt;• &lt;b&gt;Session &amp;amp; Identity:&lt;/b&gt; Manages conversation session &amp;amp; enterprise security identity&lt;br&gt;• &lt;b&gt;Direct RAG:&lt;/b&gt; Performs native RAG search across Part 1 Data Stores (GCS &amp;amp; BigQuery)&lt;br&gt;• &lt;b&gt;Central LLM Router:&lt;/b&gt; Decides whether to answer directly or route to a specialized Agent&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E8FD;strokeColor=#9334E6;strokeWidth=2;fontFamily=Helvetica;fontSize=13;fontColor=#202124;shadow=1;arcSize=10;" parent="1" vertex="1">
                    <mxGeometry x="220" y="160" width="660" height="150" as="geometry"/>
                </mxCell>
                <mxCell id="edge_user_prompt" value="User Prompt" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=#4285F4;strokeWidth=2.5;fontSize=12;fontStyle=1;fontColor=#1A73E8;" parent="1" source="browser" target="primary_assistant" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="dialogflow_agent" value="&lt;b style=&quot;font-size:13px;&quot;&gt;CONVERSATIONAL QA AGENT&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#c5221f&quot;&gt;&lt;b&gt;(Dialogflow CX)&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;hr style=&quot;border: 0; border-top: 1px solid #fca5a5; margin: 6px 0;&quot;&gt;&lt;div align=&quot;left&quot; style=&quot;font-size:11px; line-height: 1.5; padding: 0 4px;&quot;&gt;&lt;b&gt;• WHERE CREATED:&lt;/b&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;Dialogflow CX Console &amp;amp;&lt;br&gt;&amp;nbsp;&amp;nbsp;&lt;code&gt;terraform/dialogflow_cx.tf&lt;/code&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;• RUNTIME:&lt;/b&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;Dialogflow CX managed&lt;br&gt;&amp;nbsp;&amp;nbsp;service (&lt;code&gt;global&lt;/code&gt;)&lt;br&gt;&lt;br&gt;&lt;b&gt;• BRAIN:&lt;/b&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;Generative Playbook&lt;br&gt;&amp;nbsp;&amp;nbsp;(Policy, Guardrails, Clearances)&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCE8E6;strokeColor=#EA4335;strokeWidth=2;fontFamily=Helvetica;fontSize=12;fontColor=#202124;shadow=1;arcSize=10;" parent="1" vertex="1">
                    <mxGeometry x="70" y="400" width="290" height="240" as="geometry"/>
                </mxCell>
                <mxCell id="a2a_agent" value="&lt;b style=&quot;font-size:13px;&quot;&gt;REMOTE SUPPLY-CHAIN&lt;br&gt;A2A AGENT&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#137333&quot;&gt;&lt;b&gt;(A2A Open Protocol)&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;hr style=&quot;border: 0; border-top: 1px solid #86efac; margin: 6px 0;&quot;&gt;&lt;div align=&quot;left&quot; style=&quot;font-size:11px; line-height: 1.5; padding: 0 4px;&quot;&gt;&lt;b&gt;• WHERE CREATED:&lt;/b&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;External Web Service&lt;br&gt;&amp;nbsp;&amp;nbsp;(Cloud Run / Remote API)&lt;br&gt;&lt;br&gt;&lt;b&gt;• RUNTIME:&lt;/b&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;Remote HTTPS Endpoint&lt;br&gt;&lt;br&gt;&lt;b&gt;• HOW REGISTERED:&lt;/b&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;Paste JSON Agent Card&lt;br&gt;&amp;nbsp;&amp;nbsp;into Gemini Enterprise&lt;br&gt;&amp;nbsp;&amp;nbsp;(&lt;code&gt;double_click_a2a_agent_card.json&lt;/code&gt;)&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F4EA;strokeColor=#137333;strokeWidth=2;fontFamily=Helvetica;fontSize=12;fontColor=#202124;shadow=1;arcSize=10;" parent="1" vertex="1">
                    <mxGeometry x="390" y="400" width="305" height="250" as="geometry"/>
                </mxCell>
                <mxCell id="adk_agent" value="&lt;b style=&quot;font-size:13px;&quot;&gt;CODE-FIRST CONCIERGE&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#0288d1&quot;&gt;&lt;b&gt;(ADK Agent)&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;hr style=&quot;border: 0; border-top: 1px solid #7dd3fc; margin: 6px 0;&quot;&gt;&lt;div align=&quot;left&quot; style=&quot;font-size:11px; line-height: 1.5; padding: 0 4px;&quot;&gt;&lt;b&gt;• WHERE CREATED:&lt;/b&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;Python code (&lt;code&gt;agent.py&lt;/code&gt;)&lt;br&gt;&amp;nbsp;&amp;nbsp;deployed via ADK CLI / SDK&lt;br&gt;&lt;br&gt;&lt;b&gt;• RUNTIME:&lt;/b&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;Vertex AI Agent Engine&lt;br&gt;&amp;nbsp;&amp;nbsp;(&lt;code&gt;europe-west1&lt;/code&gt;)&lt;br&gt;&lt;br&gt;&lt;b&gt;• HOW REGISTERED:&lt;/b&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;Paste ReasoningEngine&lt;br&gt;&amp;nbsp;&amp;nbsp;Resource String in console&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1F5FE;strokeColor=#0288D1;strokeWidth=2;fontFamily=Helvetica;fontSize=12;fontColor=#202124;shadow=1;arcSize=10;" parent="1" vertex="1">
                    <mxGeometry x="730" y="400" width="290" height="240" as="geometry"/>
                </mxCell>
                <mxCell id="edge_route_cx" value="Internal Route" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.15;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=#EA4335;strokeWidth=2;fontSize=11;fontStyle=1;fontColor=#C5221F;" parent="1" source="primary_assistant" target="dialogflow_agent" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="edge_route_a2a" value="Remote A2A Dispatch" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=#137333;strokeWidth=2;fontSize=11;fontStyle=1;fontColor=#0D652D;" parent="1" source="primary_assistant" target="a2a_agent" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="edge_route_adk" value="Execution Call" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.85;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=#0288D1;strokeWidth=2;fontSize=11;fontStyle=1;fontColor=#01579B;" parent="1" source="primary_assistant" target="adk_agent" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
