# ============================================================================
# Gemini Enterprise Series — Unified Environment Configuration (.env)
# Copy this file to `.env` and fill in your Google Cloud project ID:
#   cp .env.example .env
# ============================================================================

# Core Google Cloud Settings
PROJECT_ID="your-gcp-project-id"
REGION="europe-west1"
DISCOVERY_ENGINE_LOCATION="global"

# DoubleClick Enterprise Branding & App Naming
APP_NAME="double-click"
COMPANY_NAME="DoubleClick Enterprise"

# Part 1: Knowledge Base Management (Ingestion + Federation)
BQ_DATASET_ID="double_click_kb"
GCS_BUCKET_SUFFIX="docs-staging"
FEDERATED_CONNECTOR_SOURCE="jira"           # e.g., jira, confluence, salesforce, slack
ENABLE_FEDERATED_CONNECTOR="false"          # Set to "true" once OAuth/API credentials are in Secret Manager

# Part 2: Conversational Modeling (Dialogflow CX + ADK Agent Engine + A2A)
DIALOGFLOW_TIME_ZONE="Europe/Rome"
DIALOGFLOW_DEFAULT_LANGUAGE="en"
ADK_AGENT_DISPLAY_NAME="double-click-adk-concierge"
GEMINI_MODEL="gemini-2.5-pro"

# Part 3: UX/UI & Accessibility (Branding, Widget, Shortcuts)
COMPANY_LOGO_URL="https://upload.wikimedia.org/wikipedia/commons/6/6b/Double-click-161563.svg"
SHORTCUT_TITLE="Google News"
SHORTCUT_URL="https://news.google.com/"
ALLOWLISTED_DOMAINS="localhost,internal.doubleclick.example.com"

# Part 4: Architecture & Monitoring (OpenTelemetry Tracing & BigQuery Log Sink)
BQ_LOGS_DATASET_ID="double_click_agent_logs"
GOOGLE_CLOUD_AGENT_ENGINE_ENABLE_TELEMETRY="true"
OTEL_INSTRUMENTATION_GENAI_CAPTURE_MESSAGE_CONTENT="EVENT_ONLY"

# Part 5: Integration & Security (Per-User OAuth 2.0 Actions & Workforce Identity)
ENABLE_WORKFORCE_IDENTITY="false"
WORKFORCE_POOL_ID="double-click-wif-pool"
OAUTH_ACTION_SECRET_ID="double-click-jira-action-oauth-secret"
PORTAL_PORT="8080"
